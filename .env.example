# Supabase — https://supabase.com/dashboard → Project Settings → API
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# RevenueCat — https://app.revenuecat.com (iOS + Android public keys)
EXPO_PUBLIC_REVENUECAT_IOS_KEY=appl_xxx
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=goog_xxx

# Supabase Edge Functions secret (set in Supabase Dashboard → Edge Functions → Secrets)
# OPENAI_API_KEY=sk-...

# Legal URLs (update after Vercel deploy)
EXPO_PUBLIC_PRIVACY_URL=https://nova-health.vercel.app/legal/privacy.html
EXPO_PUBLIC_TERMS_URL=https://nova-health.vercel.app/legal/terms.html

# Local UI testing without login (never enable in production)
# EXPO_PUBLIC_DEMO_MODE=true
